{
  "type": "azure-devops",
  "label": "Azure DevOps",
  "cli": [
    "ado"
  ],
  "fields": {
    "org": {
      "label": "Organization",
      "placeholder": "the name after dev.azure.com/"
    },
    "project": {
      "label": "Project"
    }
  },
  "match": "\\b(?:me|item|items|comments|types|states|fields|areas|iterations|pipelines|runs|run|why|log|releases|release|comment|update|create)\\b",
  "auth": {
    "signin": {
      "identity": "tool",
      "label": "az login",
      "login": "az login --allow-no-subscriptions"
    }
  },
  "test": "az account show --query user.name -o tsv",
  "expect": "^(\\S+)\\s*$",
  "denied": "az login|AADSTS|expired",
  "down": "Max retries exceeded|Failed to establish|timed out|CERTIFICATE_VERIFY_FAILED",
  "verbs": [
    {
      "pattern": "^(?:--json\\s+|--conn\\s+\\S+\\s+)*(?:comment|update|create)\\b",
      "verb": "write"
    },
    {
      "pattern": "^(?:--json\\s+|--conn\\s+\\S+\\s+)*(?:me|item|items|comments|types|states|fields|areas|iterations|pipelines|runs|run|why|log|releases|release)\\b",
      "verb": "read"
    }
  ],
  "show": {
    "item": "\\b(?:item|comment|update|comments)\\s+(\\d+)",
    "run": "\\b(?:run|why|log)\\s+(\\d+)"
  },
  "rules": {
    "none": {
      "read": "allow",
      "write": "outbox",
      "exec": "human",
      "destroy": "deny"
    }
  },
  "item": "\\bado(?:\\.cmd)?[\"']?\\s+(?:--json\\s+|--conn\\s+\\S+\\s+)*(?:comment|update)\\s+(\\d+)",
  "link": "ado"
}
