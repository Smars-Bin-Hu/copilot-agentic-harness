{
  "systems": {
    "ado-any": {
      "reach": {
        "cli": [
          "az"
        ],
        "when": "(?:dev|vsrm\\.dev)\\.azure\\.com/|\\.visualstudio\\.com/",
        "also": {
          "type": "azure-devops",
          "field": "url"
        }
      },
      "env": "none",
      "verbs": [
        {
          "pattern": "(?:--method|-m)\\s+['\"]?delete\\b",
          "verb": "destroy"
        },
        {
          "pattern": "(?:--method|-m)\\s+['\"]?(?:post|put|patch)\\b",
          "verb": "write"
        },
        {
          "pattern": "\\brest\\b",
          "verb": "read"
        }
      ],
      "show": {
        "api": "_apis/([\\w/.-]+)"
      },
      "rules": {
        "none": {
          "read": "allow",
          "write": "outbox",
          "exec": "outbox",
          "destroy": "deny"
        }
      },
      "say": [
        {
          "pattern": "(?:--method|-m)\\s+['\\\"]?(?:post|put|patch)\\b",
          "text": {
            "en": "Change Azure DevOps with az rest",
            "zh": "用 az rest 修改 Azure DevOps"
          }
        }
      ]
    },
    "ado-az": {
      "reach": {
        "cli": [
          "az"
        ],
        "when": "^\\s*(?:devops|boards|pipelines)\\b"
      },
      "env": "none",
      "verbs": [
        {
          "pattern": "(?:--http-method|-m)\\s+['\\\"]?delete\\b|^\\s*(?:devops|boards|pipelines)(?:\\s+[a-z][a-z-]*){0,3}\\s+delete(?=\\s|$)",
          "verb": "destroy"
        },
        {
          "pattern": "^\\s*devops\\s+invoke\\b.*--http-method\\s+['\\\"]?(?:post|put|patch)\\b",
          "verb": "write"
        },
        {
          "pattern": "^\\s*devops\\s+invoke\\b",
          "verb": "read"
        },
        {
          "pattern": "^\\s*(?:devops|boards|pipelines)(?:\\s+[a-z][a-z-]*){0,3}\\s+(?:show|list|query|list-[a-z-]+)(?=\\s|$)",
          "verb": "read"
        },
        {
          "pattern": "^\\s*(?:devops|boards|pipelines)(?:\\s+[a-z][a-z-]*){0,3}\\s+(?:--help|-h)\\s*$",
          "verb": "read"
        }
      ],
      "say": [
        {
          "pattern": "^\\s*(?:devops|boards|pipelines)\\b",
          "text": {
            "en": "Change Azure DevOps with az (use the ado program instead)",
            "zh": "用 az 修改 Azure DevOps（请改用 ado 程序）"
          }
        }
      ],
      "rules": {
        "none": {
          "read": "allow",
          "write": "outbox",
          "exec": "outbox",
          "destroy": "deny"
        }
      }
    },
    "ado-curl": {
      "reach": {
        "cli": [],
        "by_address": [
          "curl"
        ],
        "when": "(?:^|[\\s'\\\"=/@])(?:dev|vsrm\\.dev)\\.azure\\.com(?![\\w.-])|(?:^|[\\s'\\\"=/@])(?:[\\w-]+\\.)+visualstudio\\.com(?![\\w.-])",
        "also": {
          "type": "azure-devops",
          "field": "url"
        }
      },
      "env": "none",
      "verbs": [
        {
          "pattern": "(?:^|\\s)(?:(?-i:-[A-Za-z]*X)|--request)[\\s=]*['\\\"]?(?i:delete)\\b",
          "verb": "destroy"
        },
        {
          "pattern": "(?:^|\\s)(?:(?-i:-[A-Za-z]*X)|--request)[\\s=]*['\\\"]?(?!(?i:get|head|options)\\b)[A-Za-z]+",
          "verb": "write"
        },
        {
          "pattern": "(?:^|\\s)(?:(?-i:-[A-Za-z]*[dFT])|--data(?:-[\\w]+)?|--form(?:-string)?|--upload-file|--json)",
          "verb": "write"
        },
        {
          "pattern": "^",
          "verb": "read"
        }
      ],
      "show": {
        "api": "_apis/([\\w/.-]+)"
      },
      "rules": {
        "none": {
          "read": "allow",
          "write": "outbox",
          "exec": "outbox",
          "destroy": "deny"
        }
      },
      "say": [
        {
          "pattern": "(?:^|\\s)(?:(?:(?-i:-[A-Za-z]*[dFT])|--data(?:-[\\w]+)?|--form(?:-string)?|--upload-file|--json)|(?:(?-i:-[A-Za-z]*X)|--request))",
          "text": {
            "en": "Change Azure DevOps with curl",
            "zh": "用 curl 修改 Azure DevOps"
          }
        }
      ]
    }
  }
}
