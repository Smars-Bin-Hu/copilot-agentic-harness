# Task Level runtime state and diagnostics
.harness/runtime/

# Eval run output
.harness/eval/results/

# Samples of gate blocks a person judged wrong (written by the board; they hold the person's own commands)
.harness/eval/fixtures/gate/

# Machine-local settings (a local path, a name, how this terminal prints)
.harness/policies/target.override.json
.harness/policies/user.override.json
.harness/policies/cli.override.json
.harness/policies/tools.override.json

# The person's identities for the servers (Get ready, Servers): never in git
.harness/.env
.harness/.env.tmp

# The CA bundle Get ready makes for the tools of this computer (1.7.11)
.harness/certs/

# Python cache
__pycache__/
*.pyc

# Workspace runtime content (keep only .gitkeep)
.workspace/sandbox/*
!.workspace/sandbox/tasks/
.workspace/sandbox/tasks/*
!.workspace/sandbox/tasks/.gitkeep
.workspace/reports/*
!.workspace/reports/.gitkeep
.workspace/goals/*
!.workspace/goals/.gitkeep

# OS
.DS_Store

# The Start Harness shortcut of this Windows computer (it holds full paths)
/Start Harness.lnk

# Logs / env
*.log
.env

# Local harness design and development notes
/.local/

# Node (if tooling is added later)
node_modules/

# Local Claude Code development notes (not shipped to Copilot users)
/CLAUDE.md
/.claude/
