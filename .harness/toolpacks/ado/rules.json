          "pattern": "(?:^|\\s)(?:-(?:me(?:t(?:h(?:o(?:d)?)?)?)?|cu(?:s(?:t(?:o(?:m(?:m(?:e(?:t(?:h(?:o(?:d)?)?)?)?)?)?)?)?)?)?))[\\s:=]+['\\\"]?(?!(?:get|head|options)\\b)[A-Za-z$(@]|(?:^|\\s)(?:-(?:me(?:t(?:h(?:o(?:d)?)?)?)?|cu(?:s(?:t(?:o(?:m(?:m(?:e(?:t(?:h(?:o(?:d)?)?)?)?)?)?)?)?)?)?))(?:\\s*$)|(?:^|\\s)(?:-bo(?:d(?:y)?)?|-in(?:f(?:i(?:l(?:e)?)?)?)?|-fo(?:r(?:m)?)?)(?=[\\s:=]|$)|x-http-method-override['\\\"]*\\s*(?:[:=]|=>)\\s*['\\\"]*(?:post|put|patch|merge)\\b",
          "verb": "write"
        },
        {
          "pattern": "(?:^|\\s)(?:(?-i:-[A-Za-z]*X)|--request)[\\s=]*['\\\"]?(?!(?i:get|head|options)\\b)[A-Za-z$]+",
          "verb": "write"
        },
        {
          "pattern": "(?:^|\\s)(?:(?-i:-[A-Za-z]*[dFT])|--data(?:-[\\w]+)?|--form(?:-string)?|--upload-file|--json)",
          "verb": "write"
        },
        {
          "pattern": "^",
          "verb": "read"
        }
      ],
      "show": {
        "api": "_apis/([\\w/.-]+)"
      },
      "rules": {
        "none": {
          "read": "allow",
          "write": "outbox",
          "exec": "outbox",
          "destroy": "deny"
        }
      },
      "say": [
        {
          "pattern": "(?:^|\\s)(?:(?:(?-i:-[A-Za-z]*[dFT])|--data(?:-[\\w]+)?|--form(?:-string)?|--upload-file|--json)|(?:(?-i:-[A-Za-z]*X)|--request))|(?:^|\\s)(?:-(?:me(?:t(?:h(?:o(?:d)?)?)?)?|cu(?:s(?:t(?:o(?:m(?:m(?:e(?:t(?:h(?:o(?:d)?)?)?)?)?)?)?)?)?)?))[\\s:=]+['\\\"]?(?!(?:get|head|options)\\b)[A-Za-z$(@]|(?:^|\\s)(?:-(?:me(?:t(?:h(?:o(?:d)?)?)?)?|cu(?:s(?:t(?:o(?:m(?:m(?:e(?:t(?:h(?:o(?:d)?)?)?)?)?)?)?)?)?)?))(?:\\s*$)|(?:^|\\s)(?:-bo(?:d(?:y)?)?|-in(?:f(?:i(?:l(?:e)?)?)?)?|-fo(?:r(?:m)?)?)(?=[\\s:=]|$)|x-http-method-override['\\\"]*\\s*(?:[:=]|=>)\\s*['\\\"]*(?:post|put|patch|merge|delete)\\b",
          "text": {
            "en": "Change Azure DevOps with curl",
            "zh": "用 curl 修改 Azure DevOps"
          }
        }
      ],
      "body": [
        {
          "pattern": "(?:^|\\s)(?:-d|-F|--data(?:-raw|-binary|-ascii|-urlencode)?|--form(?:-string)?|--json)[\\s=]*'([^']*)'",
          "from": "text",
          "raw": true
        },
        {
          "pattern": "(?:^|\\s)(?:-d|-F|--data(?:-raw|-binary|-ascii|-urlencode)?|--form(?:-string)?|--json)[\\s=]*\"((?:[^\"\\\\]|\\\\.)*)\"",
          "from": "text",
          "raw": true
        },
        {
          "pattern": "(?:^|\\s)(?:-d|-F|--data(?:-raw|-binary|-ascii|-urlencode)?|--form(?:-string)?|--json)[\\s=]*(@?[^\\s'\"]+)",
          "from": "text",
          "raw": true
        }
      ],
      "hint": {
        "en": "Use the `ado` program for Azure DevOps (`ado --help`). It has no delete.",
        "zh": "访问 Azure DevOps 请用 `ado` 程序（`ado --help`）。它没有删除命令。"
      }
    },
