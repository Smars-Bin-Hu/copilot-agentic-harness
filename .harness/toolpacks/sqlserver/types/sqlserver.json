{
  "type": "sqlserver",
  "label": "SQL Server",
  "description": "A sample connection type, brought by the sqlserver tool pack; the harness knows no type. sqlcmd reaches the server; the way in is a Windows account (the network identity of the window, as runas /netonly gives it) or a SQL account (sqlcmd reads it from SQLCMDUSER and SQLCMDPASSWORD). The test asks the server who the session is.",
  "cli": [
    "sqlcmd"
  ],
  "fields": {
    "host": {
      "label": "Server",
      "placeholder": "sql-dev.example.local"
    },
    "port": {
      "label": "Port",
      "default": "1433"
    },
    "database": {
      "label": "Database",
      "optional": true
    }
  },
  "match": "-S\\s+\"?{host}(?:,{port})?(?![\\w.,-])",
  "auth": {
    "windows": {
      "label": "Windows account (DOMAIN\\id)",
      "identity": "netonly",
      "args": "-E"
    },
    "sql": {
      "label": "SQL account",
      "identity": "env",
      "env": {
        "SQLCMDUSER": "account",
        "SQLCMDPASSWORD": "password"
      },
      "args": ""
    }
  },
  "test": "sqlcmd -S {host},{port} {auth} -C -l 5 -h -1 -W -Q \"SET NOCOUNT ON; SELECT SUSER_SNAME()\"",
  "expect": "^\\s*(\\S+)\\s*$",
  "denied": "Login failed|Cannot generate SSPI context|The login is from an untrusted domain",
  "down": "TCP Provider|Named Pipes Provider|Login timeout expired|Cannot open server|network-related or instance-specific error|unable to open tcp connection|connection refused|i/o timeout",
  "verbs": [
    {
      "pattern": "\\b(?:drop|truncate|kill|shutdown|restore)\\b",
      "verb": "destroy"
    },
    {
      "pattern": "\\binto\\b|\\b(?:insert|update|delete|merge|create|alter|grant|revoke)\\b",
      "verb": "write"
    },
    {
      "pattern": "\\b(?:begin\\s+tran(?:saction)?|commit|rollback|save\\s+tran(?:saction)?|dbcc|backup|reconfigure|deny|disable\\s+trigger|enable\\s+trigger|openrowset|opendatasource|openquery|bulk|xp_\\w+)\\b",
      "verb": "write"
    },
    {
      "pattern": "\\bexec(?:ute)?\\b|\\bsp_\\w+",
      "verb": "exec"
    },
    {
      "pattern": "\\s-i\\s",
      "verb": "write"
    },
    {
      "pattern": "\\b(?:select|with|set\\s+nocount)\\b",
      "verb": "read"
    }
  ],
  "input": {
    "options": [
      "-i"
    ],
    "include": "^\\s*:r\\s+(?:\"([^\"\\r\\n]+)\"|(\\S+))"
  },
  "body": [
    {
      "pattern": "(?:^|\\s)-[Qq]\\s+\"((?:[^\"\\\\]|\\\\.)*)\"",
      "from": "text",
      "raw": true,
      "label": {
        "en": "The statement that will run",
        "zh": "将要执行的语句"
      }
    },
    {
      "pattern": "(?:^|\\s)-[Qq]\\s+'([^']*)'",
      "from": "text",
      "raw": true,
      "label": {
        "en": "The statement that will run",
        "zh": "将要执行的语句"
      }
    }
  ],
  "target": "\\b(?:from|into|update|join)\\s+([\\w.\\[\\]]+)",
  "show": {
    "server": "-S\\s+\"?([^\\s,\"]+)",
    "port": "-S\\s+\"?[^\\s,\"]+,(\\d+)",
    "database": "-d\\s+(\\S+)"
  },
  "open": {
    "dev": "all",
    "ist": "all",
    "qat": "no",
    "prod": "no"
  },
  "rules": {
    "dev": {
      "read": "allow",
      "write": "outbox",
      "exec": "outbox",
      "destroy": "deny"
    },
    "ist": {
      "read": "allow",
      "write": "outbox",
      "exec": "outbox",
      "destroy": "deny"
    },
    "qat": {
      "read": "allow",
      "write": "outbox",
      "exec": "human",
      "destroy": "deny"
    }
  }
}
