{
  "type": "demotracker",
  "label": "Demo tracker",
  "cli": [
    "demotracker"
  ],
  "fields": {
    "project": {
      "label": "Project",
      "placeholder": "DEMO"
    }
  },
  "match": "--project\\s+{project}\\b",
  "auth": {
    "signin": {
      "identity": "tool",
      "label": "Its own sign-in",
      "login": "demotracker --project {project} login"
    }
  },
  "test": "demotracker --project {project} whoami",
  "expect": "^(\\S+)\\s*$",
  "denied": "not signed in",
  "verbs": [
    {
      "pattern": "\\bdelete\\b",
      "verb": "destroy"
    },
    {
      "pattern": "\\b(?:comment|set-state)\\b",
      "verb": "write"
    },
    {
      "pattern": "\\b(?:get|list|whoami)\\b",
      "verb": "read"
    }
  ],
  "show": {
    "ticket": "\\b(?:get|comment|set-state|delete)\\s+(\\S+)"
  },
  "rules": {
    "none": {
      "read": "allow",
      "write": "outbox",
      "exec": "human",
      "destroy": "deny"
    }
  },
  "item": "\\bdemotracker(?:\\.cmd)?\\s+--project\\s+\\S+\\s+(?:comment|set-state)\\s+(\\S+)",
  "link": "demo"
}
