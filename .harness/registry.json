{
  "schema_version": 1,
  "version": "1.2.0",
  "released": "2026-10-11",
  "copyright": "Smars Hu",
  "contributors": [
    "Claude Code"
  ],
  "engine": {
    "files": [
      ".harness/engine/hook.py",
      ".harness/engine/cli.py",
      ".harness/engine/doctor.py",
      ".harness/engine/core/",
      ".harness/engine/adapters/copilot_vscode.py",
      ".harness/engine/adapters/tool_kinds.json",
      ".github/hooks/harness.json",
      ".harness/policies/cli.json",
      ".harness/policies/user.json",
      ".harness/bin/harness",
      ".harness/bin/harness.cmd",
      ".github/skills/harness-repo-initialize/",
      ".harness/eval/fixtures/hooks/copilot-sdk/",
      ".harness/tests/test_breaker.py",
      ".harness/tests/test_docs.py"
    ]
  },
  "modules": {
    "task": {
      "status": "active",
      "enabled": true,
      "events": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PostToolUse",
        "SubagentStart",
        "Stop"
      ],
      "enforcement": [
        "S",
        "C",
        "H"
      ],
      "surfaces_verified": [
        "vscode"
      ],
      "files": [
        ".harness/policies/task.json",
        ".harness/policies/target.json",
        ".harness/policies/agents.json",
        ".harness/engine/modules/task/",
        ".harness/contracts/templates/task/",
        ".github/skills/harness-my-task/",
        ".github/skills/harness-task-report/",
        ".github/skills/harness-quick-start/",
        ".github/agents/reviewer.agent.md",
        ".harness/tests/test_task.py",
        ".harness/tests/test_tasklife.py",
        ".harness/tests/test_taskboard.py",
        ".harness/tests/test_taskreview.py",
        ".harness/tests/test_taskrules.py",
        ".harness/tests/test_targets.py",
        ".harness/tests/test_promote.py"
      ],
      "retire_when": "Copilot 原生提供跟着任务走、能换会话接力的任务状态，并且有能拦住交付的批准。那时只留 gate 和 promote"
    },
    "gate": {
      "status": "active",
      "enabled": true,
      "events": [
        "PreToolUse"
      ],
      "enforcement": [
        "S",
        "H"
      ],
      "surfaces_verified": [
        "vscode"
      ],
      "files": [
        ".harness/policies/gate.json",
        ".harness/engine/modules/gate/",
        ".harness/bin/harness",
        ".harness/bin/harness.cmd",
        ".harness/tests/test_gate.py",
        ".harness/tests/test_gate_git.py",
        ".harness/tests/test_gate_approval.py",
        ".harness/tests/test_admin.py",
        ".github/agents/admin.agent.md",
        ".github/instructions/workspace.instructions.md",
        ".workspace/README.md"
      ],
      "retire_when": "Copilot 原生支持按路径限制写入，并能拒绝危险的终端命令。guardrail 和任务的写入范围不退役"
    },
    "observe": {
      "status": "active",
      "enabled": true,
      "events": [
        "PostToolUseFailure"
      ],
      "enforcement": [
        "V"
      ],
      "surfaces_verified": [
        "vscode"
      ],
      "files": [
        ".harness/policies/observe.json",
        ".harness/engine/modules/observe/",
        ".harness/tests/test_observe.py"
      ],
      "retire_when": "Copilot 提供按会话的 hook 调用日志和用量统计"
    },
    "evalcheck": {
      "status": "active",
      "enabled": true,
      "events": [],
      "enforcement": [
        "V"
      ],
      "surfaces_verified": [
        "vscode"
      ],
      "files": [
        ".harness/engine/modules/evalcheck/",
        ".harness/eval/scenarios/",
        ".harness/tests/test_evalcheck.py"
      ],
      "retire_when": "Copilot 提供自己的 agent eval 和场景回归工具"
    }
  }
}
