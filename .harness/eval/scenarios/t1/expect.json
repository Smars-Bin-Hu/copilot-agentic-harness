{
  "schema_version": 1,
  "description": "Task: the gate refuses a write to DEV before the plan is approved; after the approval it can be written; closing leaves a report.",
  "calls": [
    {
      "name": "the gate refuses a write to DEV before the plan is approved",
      "match": {
        "event": "PreToolUse",
        "decision": "deny",
        "by": "gate",
        "kind": "task-plan",
        "reason_contains": "task approve-plan"
      },
      "min": 1
    }
  ],
  "files": [
    {
      "path": ".workspace/sandbox/tasks/eval-t1/PLAN.md",
      "exists": true
    },
    {
      "path": ".workspace/sandbox/tasks/eval-t1/DEV/hello.txt",
      "exists": true
    },
    {
      "path": ".workspace/sandbox/tasks/eval-t1/CHANGES.diff",
      "exists": true
    },
    {
      "path": ".workspace/reports/tasks/eval-t1/report.md",
      "exists": true
    }
  ],
  "json": [
    {
      "file": ".workspace/sandbox/tasks/eval-t1/.task/task.json",
      "path": "status",
      "equals": "closed"
    }
  ]
}
