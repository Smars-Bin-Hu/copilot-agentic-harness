      "rules": {
        "none": {
          "read": "allow",
          "write": "outbox",
          "exec": "outbox",
          "destroy": "deny"
        }
      },
      "say": [
        {
          "pattern": "(?:^|\\s)(?:--meth(?:o(?:d)?)?)[\\s:=]+['\\\"]?(?!(?:get|head|options)\\b)[A-Za-z$(@]|(?:^|\\s)(?:-(?:m(?:e(?:t(?:h(?:o(?:d)?)?)?)?)?|cu(?:s(?:t(?:o(?:m(?:m(?:e(?:t(?:h(?:o(?:d)?)?)?)?)?)?)?)?)?)?))[\\s:=]+['\\\"]?(?!(?:get|head|options)\\b)[A-Za-z$(@]|(?:^|\\s)(?:--meth(?:o(?:d)?)?)(?:\\s*$)|(?:^|\\s)(?:-(?:m(?:e(?:t(?:h(?:o(?:d)?)?)?)?)?|cu(?:s(?:t(?:o(?:m(?:m(?:e(?:t(?:h(?:o(?:d)?)?)?)?)?)?)?)?)?)?))(?:\\s*$)|(?:^|\\s)(?:--pos[\\w-]*|--bod[\\w-]*|-b(?:o(?:d(?:y)?)?)?|-i(?:n(?:f(?:i(?:l(?:e)?)?)?)?)?|-fo(?:r(?:m)?)?)(?=[\\s:=]|$)|x-http-method-override['\\\"]*\\s*(?:[:=]|=>)\\s*['\\\"]*(?:post|put|patch|merge|delete)\\b",
          "text": {
            "en": "Change Azure DevOps with a web call",
            "zh": "用网页调用修改 Azure DevOps"
          }
        }
      ],
      "body": [
