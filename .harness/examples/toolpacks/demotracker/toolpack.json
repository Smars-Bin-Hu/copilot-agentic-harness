{
  "schema_version": 1,
  "name": "demotracker",
  "version": "1.0.0",
  "harness": "1.7.18",
  "description": "A sample tool pack for a made-up ticket board, with nothing to sign up for: a program for the terminal, and the same board as an MCP server where MCP is allowed.",
  "needs": {
    "programs": [
      "demotracker"
    ],
    "trust": []
  },
  "links": {
    "demo": {
      "label": "Ticket",
      "type": "demotracker",
      "url": "https://tracker.example.org/{project}/ticket/{id}"
    }
  },
  "mcp": {
    "tools": [
      {
        "pattern": "(get_ticket|list_tickets)$",
        "verb": "read"
      },
      {
        "pattern": "(comment_ticket|set_ticket_state)$",
        "verb": "write"
      }
    ]
  }
}
