{
  "schema_version": 1,
  "name": "example-java",
  "description": "An example of rules for a stack without its own extractor: Java classes and the classes they import. Copy it to <knowledge base>/profiles/ and change it.",
  "detect": [".java"],
  "files": [
    {
      "glob": "**/*.java",
      "extractor": "regex",
      "node": {"type": "class", "pattern": "^\\s*(?:public\\s+)?(?:abstract\\s+|final\\s+)*(?:class|interface|enum|record)\\s+(\\w+)"},
      "edges": [
        {"kind": "uses", "pattern": "^import\\s+[\\w.]*\\.(\\w+);", "as": "class"}
      ]
    }
  ],
  "ignore": ["**/test/**", "**/target/**", "**/build/**"],
  "entry_types": [],
  "shared_min": 3
}
