{
  "schema_version": 1,
  "name": "demotracker",
  "version": "1.0.0",
  "harness": "1.7.17",
  "description": "A sample connector for a made-up ticket board: the shape of a real one (Azure DevOps, Jira) with nothing to sign up for.",
  "needs": {
    "programs": [
      "demotracker"
    ],
    "trust": []
  },
  "links": {
    "demo": {
      "label": "Ticket",
      "type": "demotracker",
      "url": "https://tracker.example.org/{project}/ticket/{id}"
    }
  },
  "mcp": {
    "tools": [
      {
        "pattern": "^mcp_demotracker_(get|list|search)",
        "verb": "read"
      },
      {
        "pattern": "^mcp_demotracker_delete",
        "verb": "destroy"
      },
      {
        "pattern": "^mcp_demotracker_",
        "verb": "write"
      }
    ]
  }
}
