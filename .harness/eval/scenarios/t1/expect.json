{
  "schema_version": 1,
  "description": "任务：计划批准前写 DEV 被 gate 拒绝；批准后能写；关闭时有报告。",
  "calls": [
    {
      "name": "计划批准前写 DEV 被 gate 拒绝",
      "match": {
        "event": "PreToolUse",
        "decision": "deny",
        "by": "gate",
        "kind": "task-plan",
        "reason_contains": "task approve-plan"
      },
      "min": 1
    }
  ],
  "files": [
    {
      "path": ".workspace/sandbox/tasks/eval-t1/PLAN.md",
      "exists": true
    },
    {
      "path": ".workspace/sandbox/tasks/eval-t1/DEV/hello.txt",
      "exists": true
    },
    {
      "path": ".workspace/sandbox/tasks/eval-t1/CHANGES.diff",
      "exists": true
    },
    {
      "path": ".workspace/reports/task-eval-t1.md",
      "exists": true
    }
  ],
  "json": [
    {
      "file": ".workspace/sandbox/tasks/eval-t1/.task/task.json",
      "path": "status",
      "equals": "closed"
    }
  ]
}
