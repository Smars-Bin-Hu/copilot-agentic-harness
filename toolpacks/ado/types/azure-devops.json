{
  "type": "azure-devops",
  "label": "Azure DevOps",
  "cli": [
    "az"
  ],
  "fields": {
    "org": {
      "label": "Organization",
      "placeholder": "the name after dev.azure.com/"
    },
    "project": {
      "label": "Project"
    }
  },
  "match": "(?:dev|vsrm\\.dev)\\.azure\\.com/{org}/",
  "auth": {
    "signin": {
      "identity": "tool",
      "label": "az login",
      "login": "az login --allow-no-subscriptions"
    }
  },
  "test": "az account show --query user.name -o tsv",
  "expect": "^(\\S+)\\s*$",
  "denied": "az login|AADSTS|expired",
  "down": "Max retries exceeded|Failed to establish|timed out|CERTIFICATE_VERIFY_FAILED",
  "verbs": [
    {
      "pattern": "(?:--method|-m)\\s+['\"]?delete\\b",
      "verb": "destroy"
    },
    {
      "pattern": "(?:--method|-m)\\s+['\"]?(?:post|put|patch)\\b",
      "verb": "write"
    },
    {
      "pattern": "\\brest\\b",
      "verb": "read"
    }
  ],
  "show": {
    "api": "_apis/([\\w/.-]+)"
  },
  "rules": {
    "none": {
      "read": "allow",
      "write": "outbox",
      "exec": "human",
      "destroy": "deny"
    }
  }
}
