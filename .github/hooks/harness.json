{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "exec": "python",
        "args": [
          "-S",
          ".harness/engine/launch.py"
        ],
        "cwd": ".",
        "timeout": 120,
        "timeoutSec": 120
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "exec": "python",
        "args": [
          "-S",
          ".harness/engine/launch.py"
        ],
        "cwd": ".",
        "timeout": 120,
        "timeoutSec": 120
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "exec": "python",
        "args": [
          "-S",
          ".harness/engine/launch.py"
        ],
        "cwd": ".",
        "timeout": 120,
        "timeoutSec": 120
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "exec": "python",
        "args": [
          "-S",
          ".harness/engine/launch.py"
        ],
        "cwd": ".",
        "timeout": 120,
        "timeoutSec": 120
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "^(?:Agent|AskUserQuestion|Bash|Edit|Glob|Grep|PowerShell|Read|Write|apply_patch|ask_user|bash|create|create_file|edit|edit_notebook_file|file_search|glob|grep|grep_search|insert_edit_into_file|list_dir|multi_replace_string_in_file|powershell|read_file|replace_string_in_file|rg|runSubagent|run_in_terminal|search_code_subagent|semantic_search|task|view)$",
        "exec": "python",
        "args": [
          "-S",
          ".harness/engine/launch.py"
        ],
        "cwd": ".",
        "timeout": 120,
        "timeoutSec": 120
      }
    ],
    "PostToolUseFailure": [
      {
        "type": "command",
        "exec": "python",
        "args": [
          "-S",
          ".harness/engine/launch.py"
        ],
        "cwd": ".",
        "timeout": 120,
        "timeoutSec": 120
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "exec": "python",
        "args": [
          "-S",
          ".harness/engine/launch.py"
        ],
        "cwd": ".",
        "timeout": 120,
        "timeoutSec": 120
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "exec": "python",
        "args": [
          "-S",
          ".harness/engine/launch.py"
        ],
        "cwd": ".",
        "timeout": 120,
        "timeoutSec": 120
      }
    ],
    "Stop": [
      {
        "type": "command",
        "exec": "python",
        "args": [
          "-S",
          ".harness/engine/launch.py"
        ],
        "cwd": ".",
        "timeout": 120,
        "timeoutSec": 120
      }
    ]
  }
}
